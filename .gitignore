# Rust build outputs
/target/
/target-step5/
**/target/

# Cargo lock backup / credentials
*.orig

# Logs and caches
logs/
*.log
.cache/

# Temporary media / verification artifacts
tmp/
temp/
*.tmp

# IDE and editor temp files
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local secrets / machine-specific config
.local/
*.local.toml
secrets.toml

# OS artifacts
Desktop.ini

# Native review evidence logs must be trackable.
!docs/development/evidence/**/*.log

__pycache__/
*.pyc

# Private historical evidence is retained locally, never republished.
/docs/development/evidence/*
!/docs/development/evidence/README.md

# Local environment files may contain credentials.
.env
.env.*
!.env.example
